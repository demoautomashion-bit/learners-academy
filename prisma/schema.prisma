generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Teacher {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  phone            String
  employeeId       String              @unique
  subjects         String[]
  qualifications   String[]
  status           String              @default("active")
  avatar           String?
  joinedAt         DateTime            @default(now())
  coursesCount     Int                 @default(0)
  studentsCount    Int                 @default(0)
  assignedClass    String?
  employeePassword String?
  salary           Float               @default(0)
  requiresReview   Boolean             @default(false)
  commissionRate   Float               @default(0.2)
  assignments      Assignment[]
  audioFiles       AudioFile[]
  courses          Course[]
  payrollRecords   PayrollRecord[]
  attendance       TeacherAttendance[]
  syllabi          LessonSyllabus[]
}

model TeacherAttendance {
  id              String   @id @default(cuid())
  teacherId       String
  date            DateTime @default(now())
  status          String
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  details         Json?
  substituteCount Int      @default(0)
  teacher         Teacher  @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, date])
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  avatar    String?
}

model Student {
  id              String       @id @default(cuid())
  name            String
  email           String?
  phone           String?
  enrolledCourses String[]
  status          String       @default("active")
  avatar          String?
  guardianName    String?
  studentId       String?      @unique
  enrolledAt      DateTime     @default(now())
  progress        Float        @default(0)
  grade           String?
  classTiming     String?
  password        String?
  evaluations     Evaluation[]
  feePayments     FeePayment[]
  submissions     Submission[]
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String
  level       String
  teacherId   String
  teacherName String
  capacity    Int
  enrolled    Int          @default(0)
  status      String       @default("active")
  duration    String
  startDate   DateTime
  endDate     DateTime
  roomNumber  String?
  thumbnail   String?
  feeAmount   Float        @default(0)
  timing      String       @default("")
  timeSlotId  String?
  assignments Assignment[]
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  timeSlot    TimeSlot?    @relation(fields: [timeSlotId], references: [id])
  evaluations Evaluation[]
  feePayments FeePayment[]
}

model TimeSlot {
  id        String   @id @default(cuid())
  startTime String
  endTime   String
  label     String?
  createdAt DateTime @default(now())
  courses   Course[]
}

model Evaluation {
  id            String   @id @default(cuid())
  studentId     String
  courseId      String
  midterm       Float?   @default(0)
  final         Float?   @default(0)
  attendance    Float?   @default(0)
  participation Float?   @default(0)
  discipline    Float?   @default(0)
  extra         Float?   @default(0)
  term          String   @default("Term 1")
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
  scores        Json?
  course        Course   @relation(fields: [courseId], references: [id])
  student       Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId, term])
}

model FeePayment {
  id          String    @id @default(cuid())
  studentId   String
  courseId    String
  amountPaid  Float     @default(0)
  totalAmount Float     @default(0)
  discount    Float     @default(0)
  status      String    @default("Unpaid")
  paymentDate DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
  course      Course    @relation(fields: [courseId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

model Expenditure {
  id          String   @id @default(cuid())
  amount      Float
  category    String
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model PayrollRecord {
  id         String    @id @default(cuid())
  teacherId  String
  month      String
  year       Int
  amount     Float
  bonus      Float     @default(0)
  deductions Float     @default(0)
  status     String    @default("Pending")
  paidAt     DateTime?
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())
  teacher    Teacher   @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, month, year])
}

model Assignment {
  id               String   @id @default(cuid())
  title            String
  description      String
  courseId         String
  courseName       String
  teacherId        String
  dueDate          DateTime
  status           String   @default("active")
  submissionsCount Int      @default(0)
  totalStudents    Int      @default(0)
  createdAt        DateTime @default(now())
  course           Course   @relation(fields: [courseId], references: [id])
  teacher          Teacher  @relation(fields: [teacherId], references: [id])
}

model Submission {
  id                  String   @id @default(cuid())
  assignmentId        String
  assignmentTitle     String
  studentId           String
  studentName         String
  submittedAt         DateTime @default(now())
  status              String   @default("pending")
  grade               Float?
  feedback            String?
  fileUrl             String?
  randomizedQuestions Json?
  answers             Json?
  aiFeedback          String?
  aiJustification     String?
  evaluationCategory  String?
  student             Student  @relation(fields: [studentId], references: [id])
}

model Question {
  id            String   @id @default(cuid())
  category      String
  type          String
  content       String
  options       String[]
  correctAnswer String?
  imageUrl      String?
  phase         String
  audioUrl      String?
  matchPairs    Json?
  passageText   String?
  isApproved    Boolean  @default(false)
  teacherId     String?
  difficulty    String   @default("Medium")
  classLevel          String?
  subQuestions        Json?
  passageTitle        String?
  speakingTitle          String?
  prepTimeSeconds        Int?
  speakingMinTimeSeconds Int?
  speakingTimeSeconds    Int?
}

model AssessmentTemplate {
  id                     String   @id @default(cuid())
  title                  String
  phase                  String
  classLevels            String[]
  courseIds              String[] @default([])
  nature                 String
  totalMarks             Int
  markAllocation         Json?
  durationMinutes        Int
  createdAt              DateTime @default(now())
  status                 String   @default("active")
  accessCode             String
  questionCount          Int      @default(10)
  adminFeedback          String?
  submittedByTeacherId   String?
  submittedByTeacherName String?
  isAdaptive             Boolean  @default(false)
  evaluationCategory     String?
  allowedTypes           String[] @default([])
}

model ActivityLog {
  id        String   @id @default(cuid())
  user      String
  action    String
  category  String
  createdAt DateTime @default(now())
}

model AudioFile {
  id        String   @id @default(cuid())
  title     String
  filename  String
  url       String
  teacherId String
  createdAt DateTime @default(now())
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
}

model SystemSettings {
  id               String    @id @default("singleton")
  academyName      String    @default("The Learners Academy")
  tagline          String    @default("Premium English Language Education")
  missionStatement String    @default("Empowering learners with world-class language education through specialized faculty and audited curricula.")
  logoUrl          String?
  termLabel        String?   @default("Term 2 Registration")
  termEndDate      DateTime?
  updatedAt        DateTime  @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  summary   String
  content   String
  category  String
  date      String
  imageUrl  String?
  createdAt DateTime @default(now())
}

model CardTemplate {
  id            String   @id @default(cuid())
  level         String   @unique
  backgroundUrl String   // Stored as base64 DataURL or URL path
  coordinates   Json     // Coordinates for placing fields: { studentName: { top, left, width, fontSize }, level: ..., midtermObtained: ... }
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model BroadcastLog {
  id             String   @id @default(cuid())
  title          String
  targetGroup    String
  recipientCount Int
  status         String   @default("Delivered")
  createdAt      DateTime @default(now())
}

model LessonSyllabus {
  id          String   @id @default(cuid())
  title       String
  scope       String   @default("single")
  cefr        String
  topic       String
  duration    String
  grammar     String[]
  vocabulary  Json?
  idioms      Json?
  timeline    Json?
  weeks       Json?
  quiz        Json?
  homework    String?
  teacherId   String
  teacherName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
}
